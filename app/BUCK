load("@gate//rules:c.bzl", "c_library", "c_test")

c_library(
    name = "app",
    srcs = [
        "src/cli.c",
        "src/dotenv.c",
        "src/mcp.c",
        "src/ops.c",
    ],
    headers = ["app.h", "src/internal.h"],
    deps = [
        "//annas:annas",
        "//core:core",
        "//json:json",
        "//ports:ports",
        "//url:url",
    ],
    visibility = ["PUBLIC"],
)

# Test-only scaffolding (fake-port wiring, output buffers, script helpers); not part of the product. Only the header
# lives here: a library may not name the ctest target, so tests/kit.c and tests/annas_kit.c (the annas kit, compiled
# from its own headers) are listed in the `srcs` of every c_test.
c_library(
    name = "testkit",
    srcs = [],
    headers = ["tests/kit.h"],
    deps = [
        ":app",
        "//annas:annas",
        "//annas:testkit",
        "//core:core",
        "//ports:ports",
    ],
    visibility = ["PUBLIC"],
)

c_test(
    name = "parse_test",
    srcs = [
        "tests/parse_test.c",
