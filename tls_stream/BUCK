load("@gate//rules:c.bzl", "c_library", "c_test")

# The adapter. src/tls_stream.c: init/connect/read/write/close and the error mapping; src/bio.c: the mbedTLS
# BIO callbacks over the transport seam (errno handling, deadline, wait); src/heap.c: the arena allocator
# handed to mbedtls_platform_set_calloc_free; src/sock.c: the production socket transport;
# src/internal.h: the private state shared by them (a placeholder the implementer fills in).
c_library(
    name = "tls_stream",
    srcs = [
        "src/bio.c",
        "src/heap.c",
        "src/sock.c",
        "src/tls_stream.c",
    ],
    headers = [
        "src/internal.h",
        "tls_stream.h",
    ],
    deps = [
        "//core:core",
        "//ports:ports",
        "gate//third_party/mbedtls:mbedtls",
    ],
    visibility = ["PUBLIC"],
)

# Test-only scaffolding: the header of the in-memory pipe to the TLS peer. Its sources, tests/kit_net.c (the
# fault-injecting transport, the manual clock) and tests/kit_peer.c (the glue to the peer), are listed in the
# `srcs` of every c_test below that uses them, because only a c_test may name the peer.
c_library(
    name = "testkit",
    srcs = [],
    headers = ["tests/kit.h"],
    deps = [
        ":tls_stream",
        "//core:core",
        "//ports:ports",
    ],
    visibility = ["PUBLIC"],
)

