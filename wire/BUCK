load("@gate//rules:c.bzl", "c_library", "c_test")

# The composition root as a module: everything with logic that the binaries of bin/ need. src/config.c: the `.env` file
# and the CA bundle; src/io.c: the bounded read and write loops over the seams; src/lazyfs.c: the lazily opened download
# directory as a ports_fs_t; src/loop.c: the MCP line loop; src/run.c: wire_run (arguments, order of work, wiring);
# src/sys.c: the libc seam (wire_sys_libc, wire_io_libc); src/internal.h: the private prototypes shared by them (a
# placeholder the implementer fills in).
c_library(
    name = "wire",
    srcs = [
        "src/config.c",
        "src/io.c",
        "src/lazyfs.c",
        "src/loop.c",
        "src/run.c",
        "src/sys.c",
    ],
    headers = [
        "src/internal.h",
        "wire.h",
    ],
    deps = [
        "//annas:annas",
        "//app:app",
        "//core:core",
        "//ports:ports",
        "//posix_clock:posix_clock",
        "//posix_env:posix_env",
        "//posix_fs:posix_fs",
        "//tls_stream:tls_stream",
    ],
    visibility = ["PUBLIC"],
)

# Test-only scaffolding: the header of the fake seams, capture buffers and post-conditions. Its source, tests/kit.c, is
# listed in the `srcs` of every c_test (like the other test kits of this repo: a library may not name the ctest target),
# and so is tests/peer.c, the glue to the gate's TLS test peer, in the c_tests that use it (only a c_test may name the peer).
c_library(
    name = "testkit",
    srcs = [],
    headers = ["tests/kit.h"],
    deps = [
        ":wire",
        "//annas:annas",
        "//app:app",
        "//core:core",
        "//ports:ports",
        "//posix_clock:posix_clock",
        "//posix_env:posix_env",
        "//posix_fs:posix_fs",
        "//tls_stream:tls_stream",
    ],
    visibility = ["PUBLIC"],
)

